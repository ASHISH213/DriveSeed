# App Profile: "server" (default) or "colab"
PROFILE=server

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Database (PostgreSQL for server profile)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/driveseed

# Redis (Queue & SSE pub/sub)
REDIS_URL=redis://localhost:6379/0

# Storage & Temp directory
TEMP_DOWNLOAD_DIR=./temp

# Security & Encryption (Fernet key for encrypting stored Google Drive refresh tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=placeholder-base64-fernet-key-32-bytes=

# Google OAuth 2.0 (drive.file scope only)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
