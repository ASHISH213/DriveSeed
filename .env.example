# ==============================================================================
# DriveSeed Environment Configuration
# ==============================================================================

# Application Profile: "server" (default) or "colab"
PROFILE=server

# Domain & TLS Configuration (Caddy reverse proxy)
# Use your public domain (e.g., driveseed.yourdomain.com) for automatic Let's Encrypt / ZeroSSL TLS,
# or "localhost" for local testing with internal Caddy certificates.
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# Server Runtime Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed CORS Origins (comma-separated).
# In production, include your HTTPS domain: https://driveseed.yourdomain.com
CORS_ORIGINS=https://localhost,http://localhost:5173,http://localhost:8000

# Security & Secrets
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# Fernet encryption key for encrypting Google Drive refresh tokens at rest (32 url-safe base64-encoded bytes)
# Generate FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=placeholder-base64-fernet-key-32-bytes=

# Google OAuth 2.0 (drive.file scope only)
# Setup in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Database (PostgreSQL for server profile)
# In Docker Compose, the host is 'postgres': postgresql+asyncpg://postgres:postgres@postgres:5432/driveseed
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/driveseed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=driveseed

# Redis (Queue & SSE pub/sub)
# In Docker Compose, the host is 'redis': redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Storage & Temporary Download Cache
# Local scratch folder where active downloads reside prior to Google Drive upload.
TEMP_DOWNLOAD_DIR=/app/temp

# Rate Limits & Per-User Concurrency Caps
MAX_ACTIVE_TASKS_PER_USER=3
MAX_CONCURRENT_STREAMS_PER_USER=2
RATE_LIMIT_TASKS_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20
